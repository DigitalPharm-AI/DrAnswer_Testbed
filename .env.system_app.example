APP_ENV=development
PATIENT_ID=patient_0000000000000001
# Backend-owned continuous conversation used by the single-patient testbed UI.
# Destructive test-data reset. Production is always blocked even when true.
TESTBED_RESET_ENABLED=true

SYSTEM_DATABASE_URL=postgresql+psycopg://backend_app_rw:change-me@127.0.0.1:5432/dranswer_backend
SYSTEM_MIGRATION_DATABASE_URL=postgresql+psycopg://backend_migration:change-me@127.0.0.1:5432/dranswer_backend
SYSTEM_STARTUP_MIGRATIONS_ENABLED=false
SYSTEM_DB_POOL_SIZE=5
SYSTEM_DB_MAX_OVERFLOW=10
SYSTEM_DB_POOL_TIMEOUT_SECONDS=30
SYSTEM_DB_POOL_RECYCLE_SECONDS=1800
SYSTEM_DB_STATEMENT_TIMEOUT_MS=30000
SYSTEM_DB_LOCK_TIMEOUT_MS=5000
SYSTEM_BASE_URL=http://127.0.0.1:8000
AGENT_BASE_URL=http://127.0.0.1:8001
# Internal admin and mutation-confirmation authentication.
# Required in development, testbeds, and production. Match the AI Server.
INTERNAL_API_TOKEN=
# Backend Server <-> AI Server shared service authentication for chat and
# Backend writes. Match .env.agent_app and keep INTERNAL_API_TOKEN separate.
AGENT_SYNC_API_TOKEN=
UI_AGENT_STATUS_CACHE_TTL_SECONDS=60
AGENT_SYNC_CHAT_TIMEOUT_SECONDS=90
# Hard service budgets leave headroom below the browser's 120s chat and
# 20s feedback request limits. Values above these caps are rejected.
AGENT_SYNC_CHAT_TOTAL_TIMEOUT_SECONDS=100
AGENT_SYNC_FEEDBACK_TOTAL_TIMEOUT_SECONDS=15
AGENT_SYNC_MAX_RETRIES=2
PROMPT_WORKBOOK_PATH=runtime/system/prompt_registry.xlsx
POLICY_WORKBOOK_PATH=runtime/system/default_notification_policies.xlsx

SIMULATION_INITIAL_TIME=2026-04-20T08:00:00

# The system UI displays the active model configuration and health hints.
LLM_PROVIDER=bedrock_anthropic
LLM_MODEL_TIER=fast
LLM_FAST_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
LLM_SONNET_MODEL=global.anthropic.claude-sonnet-5
LLM_TIMEOUT_SECONDS=60
AWS_REGION=ap-northeast-2

# P1 pilot load and cost budgets.
PILOT_LOAD_CONCURRENCY_TARGET=50
PILOT_MAX_ERROR_RATE=0.01
PILOT_HEALTH_P95_MS=1000
PILOT_ASYNC_ACCEPT_P95_MS=2000
AGENT_DAILY_COST_BUDGET_USD=50
AGENT_EVAL_COST_BUDGET_USD=10
# Set with the current provider price sheet before using cost as a launch gate.
AGENT_COST_INPUT_USD_PER_1M_TOKENS=0
AGENT_COST_OUTPUT_USD_PER_1M_TOKENS=0

# These values seed POLICY_WORKBOOK_PATH only when the workbook is first created.
MISSED_DOSE_GRACE_MINUTES=90
POLICY_DEFAULT_EXTRA_REMINDERS=1
POLICY_DEFAULT_INTERVAL_MINUTES=30
POLICY_MAX_EXTRA_REMINDERS=5
POLICY_MIN_INTERVAL_MINUTES=1
POLICY_MAX_INTERVAL_MINUTES=120
POLICY_MIN_MISSED_DOSE_AFTER_MINUTES=1
POLICY_MAX_MISSED_DOSE_AFTER_MINUTES=240
POLICY_MAX_PRIMARY_REMINDER_OFFSET_MINUTES=120
