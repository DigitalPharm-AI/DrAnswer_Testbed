APP_ENV=development
PATIENT_ID=demo-patient

SYSTEM_DATABASE_URL=sqlite:///./data/system.db
SYSTEM_BASE_URL=http://127.0.0.1:8000
AGENT_BASE_URL=http://127.0.0.1:8001
PHR_BASE_URL=http://127.0.0.1:8002
# Optional QA feedback links shown in the system UI.
QA_FEEDBACK_FORM_URL=https://forms.gle/replace-with-your-form-id
QA_FEEDBACK_SHEET_URL=https://docs.google.com/spreadsheets/d/replace-with-your-spreadsheet-id/edit
# Required when APP_ENV=production.
INTERNAL_API_TOKEN=
# Backend Server -> AI Server chat authentication. Match .env.agent_app.
AGENT_SYNC_API_TOKEN=
AGENT_SYNC_MAX_RETRIES=2
# AI Server -> Backend Server write authentication. Match .env.agent_app.
BACKEND_API_TOKEN=

PROMPT_WORKBOOK_PATH=data/prompt_registry.xlsx
POLICY_WORKBOOK_PATH=data/default_notification_policies.xlsx

SYSTEM_TRACE_LOGGING=true
SIMULATION_INITIAL_TIME=2026-04-20T08:00:00

# The system UI displays the active model configuration and health hints.
LLM_PROVIDER=bedrock_anthropic
LLM_MODEL_TIER=fast
LLM_FAST_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
LLM_SONNET_MODEL=global.anthropic.claude-sonnet-5
LLM_TIMEOUT_SECONDS=60
AWS_REGION=ap-northeast-2
AWS_BEARER_TOKEN_BEDROCK=
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_SESSION_TOKEN=your-aws-session-token
# AWS_PROFILE=your-aws-profile

# P1 pilot load and cost budgets.
PILOT_LOAD_CONCURRENCY_TARGET=50
PILOT_MAX_ERROR_RATE=0.01
PILOT_HEALTH_P95_MS=1000
PILOT_ASYNC_ACCEPT_P95_MS=2000
PILOT_PHR_REGISTER_P95_MS=3000
AGENT_DAILY_COST_BUDGET_USD=50
AGENT_EVAL_COST_BUDGET_USD=10
# Set with the current provider price sheet before using cost as a launch gate.
AGENT_COST_INPUT_USD_PER_1M_TOKENS=0
AGENT_COST_OUTPUT_USD_PER_1M_TOKENS=0

# These values seed POLICY_WORKBOOK_PATH only when the workbook is first created.
MISSED_DOSE_GRACE_MINUTES=90
POLICY_DEFAULT_EXTRA_REMINDERS=1
POLICY_DEFAULT_INTERVAL_MINUTES=30
POLICY_DEFAULT_DURATION_DAYS=7
POLICY_MAX_EXTRA_REMINDERS=5
POLICY_MIN_INTERVAL_MINUTES=1
POLICY_MAX_INTERVAL_MINUTES=120
POLICY_MIN_MISSED_DOSE_AFTER_MINUTES=1
POLICY_MAX_MISSED_DOSE_AFTER_MINUTES=240
POLICY_MAX_PRIMARY_REMINDER_OFFSET_MINUTES=120
