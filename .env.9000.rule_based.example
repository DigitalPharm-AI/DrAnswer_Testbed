# Local 9000-series runtime profile for deterministic development.
# This profile intentionally avoids Bedrock credentials by using the rule-based provider.
#
# Usage:
#   powershell -ExecutionPolicy Bypass -File tools/da_drug_9000_stack.ps1 start
#   powershell -ExecutionPolicy Bypass -File tools/da_drug_9000_stack.ps1 verify
#   powershell -ExecutionPolicy Bypass -File tools/da_drug_9000_stack.ps1 stop

APP_ENV=testbed
INTERNAL_API_TOKEN=local-9000-dev-token
AGENT_SYNC_API_TOKEN=local-9000-agent-sync-token
BACKEND_API_TOKEN=local-9000-backend-api-token

SYSTEM_BASE_URL=http://127.0.0.1:9000
AGENT_BASE_URL=http://127.0.0.1:9001
PHR_BASE_URL=http://127.0.0.1:9002

# Each service owns a separate writable runtime directory. The stack helper
# creates these directories before starting the processes.
SYSTEM_DATABASE_URL=sqlite:///./runtime/system/system.db
AGENT_DATABASE_URL=sqlite:///./runtime/agent/agent.db
PHR_DATABASE_URL=sqlite:///./runtime/phr/phr.db
# SQLite contract profile: URI-level read-only plus Agent PRAGMA query_only.
BACKEND_READ_DATABASE_URL=sqlite:///file:./runtime/system/system.db?mode=ro&uri=true
BACKEND_QUERY_MAX_ROWS=100

AGENT_EMBEDDED_WORKER_ENABLED=false
AGENT_TASK_MAX_ATTEMPTS=3
AGENT_TASK_VISIBILITY_TIMEOUT_SECONDS=300
AGENT_FEEDBACK_ENCRYPTION_KEY=bG9jYWwtOTAwMC1mZWVkYmFjay1rZXktMzItYnl0ZSE=
AGENT_FEEDBACK_ENCRYPTION_KEY_ID=local-9000-feedback-v1
AGENT_FEEDBACK_MAX_ATTEMPTS=3
AGENT_FEEDBACK_PROCESSING_LEASE_SECONDS=300
AGENT_FEEDBACK_RETRY_BASE_SECONDS=60
AGENT_FEEDBACK_RETRY_MAX_SECONDS=3600

LLM_PROVIDER=rule_based
LLM_MODEL_TIER=fast
