# Local 9000-series runtime profile for deterministic development.
# This profile intentionally avoids Bedrock credentials by using the rule-based provider.
#
# Usage:
#   powershell -ExecutionPolicy Bypass -File tools/da_drug_9000_stack.ps1 start
#   powershell -ExecutionPolicy Bypass -File tools/da_drug_9000_stack.ps1 verify
#   powershell -ExecutionPolicy Bypass -File tools/da_drug_9000_stack.ps1 stop

APP_ENV=development
INTERNAL_API_TOKEN=local-9000-dev-token

SYSTEM_BASE_URL=http://127.0.0.1:9000
AGENT_BASE_URL=http://127.0.0.1:9001
PHR_BASE_URL=http://127.0.0.1:9002

SYSTEM_DATABASE_URL=sqlite:///./data/system.db
AGENT_DATABASE_URL=sqlite:///./data/agent.db
PHR_DATABASE_URL=sqlite:///./data/phr.db

AGENT_EMBEDDED_WORKER_ENABLED=false
AGENT_TASK_MAX_ATTEMPTS=3
AGENT_TASK_VISIBILITY_TIMEOUT_SECONDS=300

LLM_PROVIDER=rule_based
LLM_MODEL_TIER=fast
