# EC2 agent-only test deployment.
# Copy to /etc/dranswer-agent/agent.env, replace every CHANGE_ME value, and
# keep the resulting file outside the release archive with mode 600.

APP_ENV=testbed
# APP_RELEASE_VERSION and AGENT_RELEASE_COMMIT_SHA are injected from the
# root-owned release.env generated from the verified release manifest.

LLM_PROVIDER=bedrock_anthropic
LLM_MODEL_TIER=sonnet
LLM_FAST_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
LLM_SONNET_MODEL=global.anthropic.claude-sonnet-4-6
LLM_REASONING_ENABLED=true
LLM_REASONING_EFFORT=medium
LLM_EXTENDED_THINKING_BUDGET_TOKENS=1024
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
AGENT_TRACE_LOGGING=true

AWS_REGION=ap-northeast-2
# Use bearer_token with /etc/dranswer-agent/bedrock.env, or iam_role with
# an EC2 instance profile. Static AWS access keys are not supported here.
BEDROCK_AUTH_MODE=bearer_token

# PostgreSQL resources must be reachable from the EC2 instance.
AGENT_DATABASE_URL=postgresql+psycopg://agent_app_rw:CHANGE_ME@CHANGE_ME_DB_HOST:5432/dranswer_agent?sslmode=require
AGENT_MIGRATION_DATABASE_URL=postgresql+psycopg://agent_migration:CHANGE_ME@CHANGE_ME_DB_HOST:5432/dranswer_agent?sslmode=require
BACKEND_READ_DATABASE_URL=postgresql+psycopg://ai_backend_reader:CHANGE_ME@CHANGE_ME_DB_HOST:5432/dranswer_backend?sslmode=require

# Existing Backend Server used by Agent write tools and callbacks.
SYSTEM_BASE_URL=https://CHANGE_ME_BACKEND_HOST
BACKEND_RECORD_CHANGE_PATH=/agent/sync/record-change
BACKEND_NOTIFICATION_POLICY_CHANGE_PATH=/agent/sync/notification-policy-change
BACKEND_API_TIMEOUT_SECONDS=90
BACKEND_API_MAX_RETRIES=2

# Generate three different random values. Never reuse one token for another.
INTERNAL_API_TOKEN=CHANGE_ME_RANDOM_INTERNAL_TOKEN
BACKEND_API_TOKEN=CHANGE_ME_RANDOM_BACKEND_TOKEN
AGENT_SYNC_API_TOKEN=CHANGE_ME_RANDOM_AGENT_SYNC_TOKEN

# URL-safe base64 encoding of exactly 32 random bytes.
AGENT_FEEDBACK_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_KEY
AGENT_FEEDBACK_ENCRYPTION_KEY_ID=ec2-test-feedback-v1

AGENT_STARTUP_MIGRATIONS_ENABLED=false
AGENT_EMBEDDED_WORKER_ENABLED=false

# Small pools are intentional for the current ~1 GiB test instance.
AGENT_DB_POOL_SIZE=2
AGENT_DB_MAX_OVERFLOW=2
AGENT_DB_POOL_TIMEOUT_SECONDS=30
AGENT_DB_POOL_RECYCLE_SECONDS=1800
AGENT_DB_STATEMENT_TIMEOUT_MS=30000
AGENT_DB_LOCK_TIMEOUT_MS=5000
BACKEND_READ_DB_POOL_SIZE=2
BACKEND_READ_DB_MAX_OVERFLOW=1
BACKEND_READ_DB_POOL_TIMEOUT_SECONDS=10
BACKEND_READ_DB_POOL_RECYCLE_SECONDS=1800
BACKEND_READ_DB_STATEMENT_TIMEOUT_MS=10000
BACKEND_READ_DB_LOCK_TIMEOUT_MS=2000

AGENT_TASK_MAX_ATTEMPTS=3
AGENT_TASK_VISIBILITY_TIMEOUT_SECONDS=300
AGENT_TASK_RETRY_BASE_SECONDS=30
AGENT_TASK_RETRY_MAX_SECONDS=600
AGENT_WORKER_HEARTBEAT_INTERVAL_SECONDS=10
AGENT_WORKER_STALE_AFTER_SECONDS=60

AGENT_SYNC_CHAT_TIMEOUT_SECONDS=90
AGENT_SYNC_MAX_RETRIES=2
AGENT_SYNC_LOCK_LEASE_SECONDS=120
AGENT_SYNC_REQUEST_RETENTION_SECONDS=86400
AGENT_SYNC_RETRY_AFTER_SECONDS=1

AGENT_FEEDBACK_RETENTION_SECONDS=604800
AGENT_FEEDBACK_MAX_ATTEMPTS=3
AGENT_FEEDBACK_PROCESSING_LEASE_SECONDS=300
AGENT_FEEDBACK_RETRY_BASE_SECONDS=60
AGENT_FEEDBACK_RETRY_MAX_SECONDS=3600

PROMPT_WORKBOOK_PATH=/opt/dranswer-agent/runtime/prompt_registry.xlsx
POLICY_WORKBOOK_PATH=/opt/dranswer-agent/runtime/default_notification_policies.xlsx
PRO_CTCAE_WORKBOOK_PATH=/opt/dranswer-agent/current/data/pro_ctcae_korean_parsed.xlsx

# Self-hosted Langfuse on a private EC2/VPC endpoint. Use project-scoped keys.
LANGFUSE_EXPORT_ENABLED=true
LANGFUSE_BASE_URL=https://CHANGE_ME_LANGFUSE_PRIVATE_DNS
LANGFUSE_PUBLIC_KEY=CHANGE_ME_LANGFUSE_PUBLIC_KEY
LANGFUSE_SECRET_KEY=CHANGE_ME_LANGFUSE_SECRET_KEY
LANGFUSE_VERIFY_TLS=true
LANGFUSE_REQUEST_TIMEOUT_SECONDS=10
LANGFUSE_EXPORT_BATCH_SIZE=20
LANGFUSE_EXPORT_POLL_SECONDS=2
LANGFUSE_EXPORT_MAX_ATTEMPTS=12
LANGFUSE_EXPORT_LEASE_SECONDS=300
LANGFUSE_EXPORT_RETRY_BASE_SECONDS=5
LANGFUSE_EXPORT_RETRY_MAX_SECONDS=900
LANGFUSE_EXPORT_CIRCUIT_FAILURE_THRESHOLD=5
LANGFUSE_EXPORT_CIRCUIT_COOLDOWN_SECONDS=60
LANGFUSE_SUCCESS_SAMPLE_RATE=1.0
LANGFUSE_OUTBOX_RETENTION_SECONDS=2592000
LANGFUSE_RETENTION_DAYS=1095

# Enter the approved Bedrock prices for the active Agent model.
AGENT_COST_INPUT_USD_PER_1M_TOKENS=CHANGE_ME
AGENT_COST_OUTPUT_USD_PER_1M_TOKENS=CHANGE_ME
