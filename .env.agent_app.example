APP_ENV=development
APP_RELEASE_VERSION=

LLM_PROVIDER=bedrock_anthropic
LLM_MODEL_TIER=sonnet
LLM_FAST_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
LLM_SONNET_MODEL=global.anthropic.claude-sonnet-4-6
LLM_REASONING_ENABLED=true
LLM_REASONING_EFFORT=medium
LLM_EXTENDED_THINKING_BUDGET_TOKENS=1024
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
AGENT_TRACE_LOGGING=true

AWS_REGION=ap-northeast-2
# Put Bedrock credentials in .env.agent_app.secret, which is loaded only by
# the Agent API and Agent worker.

AGENT_DATABASE_URL=postgresql+psycopg://agent_app_rw:change-me@127.0.0.1:5432/dranswer_agent
# Managed production connections should require verified TLS.
# If agent_app runs in Docker and PostgreSQL runs on the EC2 host:
# AGENT_DATABASE_URL=postgresql+psycopg://agent_app_rw:change-me@host.docker.internal:5432/dranswer_agent?sslmode=require
AGENT_MIGRATION_DATABASE_URL=postgresql+psycopg://agent_migration:change-me@127.0.0.1:5432/dranswer_agent
AGENT_STARTUP_MIGRATIONS_ENABLED=false
AGENT_DB_POOL_SIZE=5
AGENT_DB_MAX_OVERFLOW=10
AGENT_DB_POOL_TIMEOUT_SECONDS=30
AGENT_DB_POOL_RECYCLE_SECONDS=1800
AGENT_DB_STATEMENT_TIMEOUT_MS=30000
AGENT_DB_LOCK_TIMEOUT_MS=5000
AGENT_TASK_MAX_ATTEMPTS=3
AGENT_TASK_VISIBILITY_TIMEOUT_SECONDS=300
AGENT_TASK_RETRY_BASE_SECONDS=30
AGENT_TASK_RETRY_MAX_SECONDS=600
# Keep false in production and run `python -m agent_app.worker_main` as a separate process.
AGENT_EMBEDDED_WORKER_ENABLED=false
AGENT_WORKER_HEARTBEAT_INTERVAL_SECONDS=10
AGENT_WORKER_STALE_AFTER_SECONDS=60
# Disabled until both operating times are approved. Configure both as HH:MM
# in Asia/Seoul; never configure only one.
SYSTEM_BASE_URL=http://127.0.0.1:8000
# AI Server read-only Query Tools always use a distinct PostgreSQL
# Backend SELECT-only role.
BACKEND_READ_DATABASE_URL=postgresql+psycopg://ai_backend_reader:change-me@127.0.0.1:5432/dranswer_backend
BACKEND_QUERY_MAX_ROWS=100
BACKEND_READ_DB_POOL_SIZE=5
BACKEND_READ_DB_MAX_OVERFLOW=5
BACKEND_READ_DB_POOL_TIMEOUT_SECONDS=10
BACKEND_READ_DB_POOL_RECYCLE_SECONDS=1800
BACKEND_READ_DB_STATEMENT_TIMEOUT_MS=10000
BACKEND_READ_DB_LOCK_TIMEOUT_MS=2000
# Internal admin and mutation-confirmation authentication.
# Required in development, testbeds, and production. Match the Backend Server.
INTERNAL_API_TOKEN=
# AI Server -> Backend Server v1.3 write contract.
BACKEND_RECORD_CHANGE_PATH=/agent/sync/record-change
BACKEND_NOTIFICATION_POLICY_CHANGE_PATH=/agent/sync/notification-policy-change
# Required in development, testbeds, and production. Must be different from
# AGENT_SYNC_API_TOKEN and match the Backend Server configuration.
BACKEND_API_TOKEN=
BACKEND_API_TIMEOUT_SECONDS=90
BACKEND_API_MAX_RETRIES=2
# Backend Server -> AI Server /agent/sync/chat Bearer token.
# Required in development, testbeds, and production. Must be different from
# BACKEND_API_TOKEN and match the Backend Server configuration.
AGENT_SYNC_API_TOKEN=
AGENT_SYNC_CHAT_TIMEOUT_SECONDS=90
AGENT_SYNC_MAX_RETRIES=2
AGENT_SYNC_LOCK_LEASE_SECONDS=120
AGENT_SYNC_REQUEST_RETENTION_SECONDS=86400
AGENT_SYNC_RETRY_AFTER_SECONDS=1
# Raw async task/callback payloads are removed 30 days after terminal state.
AGENT_ASYNC_TASK_RETENTION_SECONDS=2592000
# Run expiry cleanup hourly instead of only at process startup.
AGENT_RETENTION_CLEANUP_INTERVAL_SECONDS=3600
AGENT_FEEDBACK_RETENTION_SECONDS=604800
# Required. URL-safe base64 for exactly 32 random bytes. Keep previous keys
# available during key rotation until all retained feedback has expired.
AGENT_FEEDBACK_ENCRYPTION_KEY=
AGENT_FEEDBACK_ENCRYPTION_KEY_ID=feedback-v1
AGENT_PRO_CTCAE_SURVEY_TTL_SECONDS=86400
AGENT_PRO_CTCAE_SURVEY_RETENTION_SECONDS=94608000
# Food candidate snapshots are encrypted in Agent DB so a selection reply can
# reuse the exact food_ref_id and nutrient payload without another search.
AGENT_FOOD_SELECTION_TTL_SECONDS=86400
AGENT_FOOD_SELECTION_RETENTION_SECONDS=94608000
AGENT_FEEDBACK_MAX_ATTEMPTS=3
AGENT_FEEDBACK_PROCESSING_LEASE_SECONDS=300
AGENT_FEEDBACK_RETRY_BASE_SECONDS=60
AGENT_FEEDBACK_RETRY_MAX_SECONDS=3600
PROMPT_WORKBOOK_PATH=runtime/agent/prompt_registry.xlsx
POLICY_WORKBOOK_PATH=runtime/agent/default_notification_policies.xlsx

PRO_CTCAE_WORKBOOK_PATH=data/pro_ctcae_korean_parsed.xlsx

MISSED_DOSE_GRACE_MINUTES=90
POLICY_DEFAULT_EXTRA_REMINDERS=1
POLICY_DEFAULT_INTERVAL_MINUTES=30
POLICY_MAX_EXTRA_REMINDERS=5
POLICY_MIN_INTERVAL_MINUTES=1
POLICY_MAX_INTERVAL_MINUTES=120
POLICY_MIN_MISSED_DOSE_AFTER_MINUTES=1
POLICY_MAX_MISSED_DOSE_AFTER_MINUTES=240
POLICY_MAX_PRIMARY_REMINDER_OFFSET_MINUTES=120

# P1 pilot load and cost budgets.
PILOT_LOAD_CONCURRENCY_TARGET=50
PILOT_MAX_ERROR_RATE=0.01
PILOT_HEALTH_P95_MS=1000
PILOT_ASYNC_ACCEPT_P95_MS=2000
AGENT_DAILY_COST_BUDGET_USD=50
AGENT_EVAL_COST_BUDGET_USD=10
# Set with the current provider price sheet before using cost as a launch gate.
AGENT_COST_INPUT_USD_PER_1M_TOKENS=0
AGENT_COST_OUTPUT_USD_PER_1M_TOKENS=0

# Durable Agent DB outbox -> self-hosted Langfuse over private networking.
# The API and Agent worker never call Langfuse in their request path.
LANGFUSE_EXPORT_ENABLED=false
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_VERIFY_TLS=true
LANGFUSE_REQUEST_TIMEOUT_SECONDS=10
LANGFUSE_EXPORT_BATCH_SIZE=20
LANGFUSE_EXPORT_POLL_SECONDS=2
LANGFUSE_EXPORT_MAX_ATTEMPTS=12
LANGFUSE_EXPORT_LEASE_SECONDS=300
LANGFUSE_EXPORT_RETRY_BASE_SECONDS=5
LANGFUSE_EXPORT_RETRY_MAX_SECONDS=900
LANGFUSE_EXPORT_CIRCUIT_FAILURE_THRESHOLD=5
LANGFUSE_EXPORT_CIRCUIT_COOLDOWN_SECONDS=60
# Start at 100%. When reduced later, errors, missed-dose traces, tool writes,
# and traces with user feedback remain forced samples.
LANGFUSE_SUCCESS_SAMPLE_RATE=1.0
LANGFUSE_OUTBOX_RETENTION_SECONDS=2592000
LANGFUSE_RETENTION_DAYS=1095
