{
  "openapi": "3.1.0",
  "info": {
    "title": "닥터앤서 AI Server v1.3 비동기 복약 이벤트 API",
    "version": "1.3",
    "description": "Backend Server가 미복용 이벤트 또는 분석 대상 환자 목록을 AI Server에 멱등하게 접수하는 v1.3 비동기 계약이다. 상세 환자 컨텍스트는 AI Server가 읽기 전용 Backend DB 조회로 보강한다."
  },
  "paths": {
    "/agent/async/missed-dose-events": {
      "post": {
        "summary": "Async Missed Dose Events",
        "operationId": "async_missed_dose_events_agent_async_missed_dose_events_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MissedDoseEventRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AsyncEventAccepted"
                }
              }
            }
          },
          "200": {
            "description": "The same request was already accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AsyncEventAccepted"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "AgentSyncBearer": []
          }
        ]
      }
    },
    "/agent/async/daily-medication-pattern-analysis": {
      "post": {
        "summary": "Async Daily Medication Pattern Analysis",
        "operationId": "async_daily_medication_pattern_analysis_agent_async_daily_medication_pattern_analysis_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DailyMedicationPatternAnalysisRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AsyncEventAccepted"
                }
              }
            }
          },
          "200": {
            "description": "The same request was already accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AsyncEventAccepted"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "AgentSyncBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AsyncEventAccepted": {
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^req_[0-9a-f]{16}$",
            "title": "Request Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "accepted",
              "duplicate"
            ],
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "status"
        ],
        "title": "AsyncEventAccepted"
      },
      "CommonErrorResponse": {
        "properties": {
          "request_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^req_[0-9a-f]{16}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "error": {
            "$ref": "#/components/schemas/ContractError"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "error"
        ],
        "title": "CommonErrorResponse"
      },
      "ContractError": {
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "title": "Code"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "title": "Message"
          },
          "retryable": {
            "type": "boolean",
            "title": "Retryable"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message",
          "retryable",
          "details"
        ],
        "title": "ContractError"
      },
      "DailyMedicationPatternAnalysisRequest": {
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^req_[0-9a-f]{16}$",
            "title": "Request Id"
          },
          "patient_id": {
            "items": {
              "type": "string",
              "pattern": "^patient_[0-9a-f]{16}$"
            },
            "type": "array",
            "minItems": 1,
            "title": "Patient Id"
          },
          "analysis_date": {
            "type": "string",
            "format": "date",
            "title": "Analysis Date"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "patient_id",
          "analysis_date"
        ],
        "title": "DailyMedicationPatternAnalysisRequest"
      },
      "MissedDoseEventRequest": {
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^req_[0-9a-f]{16}$",
            "title": "Request Id"
          },
          "patient_id": {
            "type": "string",
            "pattern": "^patient_[0-9a-f]{16}$",
            "title": "Patient Id"
          },
          "dose_event_id": {
            "type": "string",
            "pattern": "^dose_[0-9a-f]{16}$",
            "title": "Dose Event Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "patient_id",
          "dose_event_id"
        ],
        "title": "MissedDoseEventRequest"
      }
    },
    "securitySchemes": {
      "AgentSyncBearer": {
        "type": "http",
        "description": "Backend Server가 AI Server v1.3 동기 채팅 API를 호출할 때 사용하는 Bearer token",
        "scheme": "bearer"
      }
    }
  },
  "x-contract-scope": {
    "contract_version": "1.3",
    "public_id_suffix": "16 lowercase hexadecimal characters",
    "included": [
      "/agent/async/missed-dose-events",
      "/agent/async/daily-medication-pattern-analysis"
    ],
    "daily_pattern_trigger": "Backend가 analysis_date와 분석 대상 patient_id 목록을 전달"
  }
}
