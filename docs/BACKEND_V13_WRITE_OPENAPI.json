{
  "openapi": "3.1.0",
  "info": {
    "title": "닥터앤서 Backend v1.3 AI 쓰기 연동 API",
    "version": "1.3",
    "description": "AI Server가 사용자 확인을 마친 업무 데이터 변경을 Backend Server에 동기로 요청하는 v1.3 계약이다. 공개 식별자는 종류별 prefix와 16자리 lowercase hex 접미사를 사용한다."
  },
  "paths": {
    "/agent/sync/record-change": {
      "post": {
        "summary": "Backend Record Change",
        "operationId": "backend_record_change_agent_sync_record_change_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordChangeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordChangeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Request schema validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Bearer authentication failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "The target record was not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency, confirmation reference, or version conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Business validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected Backend processing error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "BackendApiBearer": []
          }
        ]
      }
    },
    "/agent/sync/notification-policy-change": {
      "post": {
        "summary": "Backend Policy Change",
        "operationId": "backend_policy_change_agent_sync_notification_policy_change_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificationPolicyChangeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationPolicyChangeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Request schema validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Bearer authentication failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "The public policy_id was not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency, confirmation reference, or version conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Date or policy boundary business validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected Backend processing error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "BackendApiBearer": []
          }
        ]
      }
    }
  },
  "components": {
