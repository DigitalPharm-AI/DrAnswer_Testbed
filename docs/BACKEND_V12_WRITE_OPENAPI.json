              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordChangeResponse"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency, confirmation reference, or version conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordChangeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Request or business validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordChangeResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected Backend processing error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordChangeResponse"
                }
              }
            }
          },
          "503": {
            "description": "Backend write dependency is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordChangeResponse"
                }
              }
            }
          },
          "504": {
            "description": "Backend write processing timed out.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordChangeResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "BackendApiBearer": []
          }
        ]
