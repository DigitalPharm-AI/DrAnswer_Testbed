{
  "contract": "Backend DB read contract",
  "contract_version": "1.2",
  "object_prefix": "ai_v12_",
  "access": {
    "allowed_operations": [
      "SELECT"
    ],
    "forbidden_operations": [
      "INSERT",
      "UPDATE",
      "DELETE",
      "DDL"
    ],
    "grant_policy": "Grant the AI DB role SELECT on the listed views only. Do not grant access to Backend base tables.",
    "session_requirement": "Every AI DB session must enforce transaction read-only mode."
  },
  "data_handling": {
    "query_shape": "Fixed parameterized queries owned by AI Server tools; caller-supplied SQL is prohibited.",
    "patient_scope": "patient_id is injected from trusted chat context and must be present in every patient-scoped predicate.",
    "ai_server_persistence": "Query rows and raw patient content must not be persisted in the AI internal trace/tool-state database.",
    "identifier_contract": "message, dose_event, meal, and food IDs are opaque public strings. Backend numeric primary keys are never returned as those entity IDs.",
    "legacy_compatibility": "Numeric strings are accepted only as a transition input and resolved through ai_v12_legacy_id_map. Tool responses always contain the public ID."
  },
  "readiness_gates": [
    "all views exist",
    "view columns exactly match this contract",
    "patient-scope identifiers, public IDs, and version fields contain no NULL values",
    "a zero-row SELECT succeeds for every view",
    "the DB session reports read-only mode"
  ],
  "views": {
    "ai_v12_chat_messages": {
      "patient_scoped": true,
      "columns": [
        "id",
        "patient_id",
        "conversation_id",
        "role",
        "content",
        "created_at",
        "message_type"
      ]
    },
    "ai_v12_dose_events": {
      "patient_scoped": true,
      "columns": [
        "id",
        "patient_id",
        "medication_name",
        "slot_label",
        "scheduled_for",
        "status",
        "taken_at",
        "note",
        "version"
      ]
    },
    "ai_v12_nutrition_meals": {
      "patient_scoped": true,
      "columns": [
        "id",
        "patient_id",
        "meal_type",
        "meal_date",
        "meal_time",
        "scenario_key",
        "description",
        "version"
      ]
    },
    "ai_v12_nutrition_foods": {
      "patient_scoped": "through ai_v12_nutrition_meals.meal_id",
      "columns": [
        "id",
        "meal_id",
        "food_ref_id",
        "food_name",
        "portion",
        "calories",
        "protein",
        "sodium",
        "fat",
        "carbohydrates",
        "version"
      ]
    },
    "ai_v12_nutrition_food_ref": {
      "patient_scoped": false,
      "columns": [
        "food_ref_id",
        "food_name",
        "category",
        "serving_size",
        "energy",
        "carbohydrate",
        "protein",
        "fat",
        "sodium",
        "source",
        "manufacturer"
      ]
    },
    "ai_v12_side_effect_records": {
      "patient_scoped": true,
      "columns": [
        "id",
        "patient_id",
        "phr_patient_key",
        "medication_name",
        "symptom_text",
        "suspected",
        "severity",
        "matched_effects_json",
        "matched_items_json",
        "evidence",
        "recommendation",
        "source_event_type",
        "related_dose_event_id",
        "created_at"
      ]
    },
    "ai_v12_nutrition_preferences": {
      "patient_scoped": true,
      "columns": [
        "patient_id",
        "status",
        "predicate",
        "strength",
        "safety_level",
        "confidence",
        "source",
        "evidence_text",
        "node_key",
        "node_type",
        "label"
      ]
    },
    "ai_v12_reminder_policies": {
      "patient_scoped": true,
      "columns": [
        "id",
        "patient_id",
        "public_id",
        "policy_key",
        "slot_label",
        "extra_reminders",
        "interval_minutes",
        "missed_dose_after_minutes",
        "primary_reminder_timing",
        "primary_reminder_offset_minutes",
        "effective_start_date",
        "effective_end_date",
        "active",
        "version"
      ]
    },
    "ai_v12_legacy_id_map": {
      "patient_scoped": false,
      "purpose": "Transition-only numeric-string to public-ID resolution; never return legacy_id to the model or API caller.",
      "columns": [
        "entity_type",
        "legacy_id",
        "public_id"
      ]
    }
  }
}
