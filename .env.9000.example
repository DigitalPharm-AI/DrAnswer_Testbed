# Local 9000-series runtime profile with a real generative provider.
# The stack intentionally fails readiness when Bedrock credentials, network
# access, or model invocation permission are unavailable. It never substitutes
# a synthetic or predefined response provider.
# Usage example:
#   Copy-Item .env.agent_app.secret.example .env.agent_app.secret
#   powershell -ExecutionPolicy Bypass -File tools/da_drug_9000_stack.ps1 -Action start
#   powershell -ExecutionPolicy Bypass -File tools/da_drug_9000_stack.ps1 -Action verify
#   powershell -ExecutionPolicy Bypass -File tools/da_drug_9000_stack.ps1 -Action stop

APP_ENV=development
INTERNAL_API_TOKEN=replace-with-local-internal-token
AGENT_SYNC_API_TOKEN=replace-with-local-agent-sync-token
UI_AGENT_STATUS_CACHE_TTL_SECONDS=60
BACKEND_API_TOKEN=replace-with-local-backend-api-token
SYSTEM_BASE_URL=http://127.0.0.1:9000
AGENT_BASE_URL=http://127.0.0.1:9001
PRO_CTCAE_WORKBOOK_PATH=data/pro_ctcae_korean_parsed.xlsx

SYSTEM_DATABASE_URL=postgresql+psycopg://system_app_rw@127.0.0.1:55432/dranswer_system
SYSTEM_MIGRATION_DATABASE_URL=postgresql+psycopg://system_migrator@127.0.0.1:55432/dranswer_system
SYSTEM_STARTUP_MIGRATIONS_ENABLED=false
AGENT_DATABASE_URL=postgresql+psycopg://agent_app_rw@127.0.0.1:55432/dranswer_agent
AGENT_MIGRATION_DATABASE_URL=postgresql+psycopg://agent_migrator@127.0.0.1:55432/dranswer_agent
AGENT_STARTUP_MIGRATIONS_ENABLED=false
BACKEND_READ_DATABASE_URL=postgresql+psycopg://ai_backend_reader@127.0.0.1:55432/dranswer_system
BACKEND_QUERY_MAX_ROWS=100
SYSTEM_DB_POOL_SIZE=5
SYSTEM_DB_MAX_OVERFLOW=10
AGENT_DB_POOL_SIZE=5
AGENT_DB_MAX_OVERFLOW=10
BACKEND_READ_DB_POOL_SIZE=5
BACKEND_READ_DB_MAX_OVERFLOW=5

AGENT_EMBEDDED_WORKER_ENABLED=false
AGENT_TASK_MAX_ATTEMPTS=3
AGENT_TASK_VISIBILITY_TIMEOUT_SECONDS=300
AGENT_FEEDBACK_ENCRYPTION_KEY=bG9jYWwtOTAwMC1mZWVkYmFjay1rZXktMzItYnl0ZSE=
AGENT_FEEDBACK_ENCRYPTION_KEY_ID=local-9000-feedback-v1
AGENT_FEEDBACK_MAX_ATTEMPTS=3
AGENT_FEEDBACK_PROCESSING_LEASE_SECONDS=300
AGENT_FEEDBACK_RETRY_BASE_SECONDS=60
AGENT_FEEDBACK_RETRY_MAX_SECONDS=3600

LLM_PROVIDER=bedrock_anthropic
LLM_MODEL_TIER=sonnet
LLM_SONNET_MODEL=global.anthropic.claude-sonnet-4-6
LLM_REASONING_ENABLED=true
LLM_REASONING_EFFORT=medium
LLM_EXTENDED_THINKING_BUDGET_TOKENS=1024
AWS_REGION=ap-northeast-2
# Put Bedrock credentials in .env.agent_app.secret. The 9000 launcher loads
# that overlay only in the Agent API and Agent worker.
