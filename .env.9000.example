# Local 9000-series runtime profile.
# Usage example:
#   DA_DRUG_ENV_FILE=.env.9000 uvicorn system_app.main:app --host 127.0.0.1 --port 9000
#   DA_DRUG_ENV_FILE=.env.9000 uvicorn agent_app.main:app --host 127.0.0.1 --port 9001
#   DA_DRUG_ENV_FILE=.env.9000 uvicorn phr_app.main:app --host 127.0.0.1 --port 9002
#   DA_DRUG_ENV_FILE=.env.9000 python -m agent_app.worker_main

APP_ENV=development
AGENT_SYNC_API_TOKEN=replace-with-local-agent-sync-token
BACKEND_API_TOKEN=replace-with-local-backend-api-token
SYSTEM_BASE_URL=http://127.0.0.1:9000
AGENT_BASE_URL=http://127.0.0.1:9001
PHR_BASE_URL=http://127.0.0.1:9002

SYSTEM_DATABASE_URL=sqlite:///./runtime/system/system.db
AGENT_DATABASE_URL=sqlite:///./runtime/agent/agent.db
PHR_DATABASE_URL=sqlite:///./runtime/phr/phr.db
BACKEND_READ_DATABASE_URL=sqlite:///file:./runtime/system/system.db?mode=ro&uri=true
BACKEND_QUERY_MAX_ROWS=100

AGENT_EMBEDDED_WORKER_ENABLED=false
AGENT_TASK_MAX_ATTEMPTS=3
AGENT_TASK_VISIBILITY_TIMEOUT_SECONDS=300
AGENT_FEEDBACK_ENCRYPTION_KEY=bG9jYWwtOTAwMC1mZWVkYmFjay1rZXktMzItYnl0ZSE=
AGENT_FEEDBACK_ENCRYPTION_KEY_ID=local-9000-feedback-v1
AGENT_FEEDBACK_MAX_ATTEMPTS=3
AGENT_FEEDBACK_PROCESSING_LEASE_SECONDS=300
AGENT_FEEDBACK_RETRY_BASE_SECONDS=60
AGENT_FEEDBACK_RETRY_MAX_SECONDS=3600

LLM_PROVIDER=bedrock_anthropic
LLM_MODEL_TIER=fast
